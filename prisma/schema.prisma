generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Severity {
  CRITICAL
  WARNING
  INFO
}

enum IncidentStatus {
  OPEN
  PENDING_REVIEW
  APPROVED
  DISMISSED
  PROCESSING
}

model Service {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String               @unique @db.VarChar(255)
  display_name         String?              @db.VarChar(255)
  created_at           DateTime             @default(now()) @db.Timestamptz // non-nullable
  // Relations
  anomalies            Anomaly[]

  @@map("services")
}

model Anomaly {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  metric_name  String    @db.VarChar(255)
  service_name String    @db.VarChar(255)
  service      Service   @relation(fields: [service_name], references: [name])
  severity     Severity  @default(WARNING)
  detected_at  DateTime  @db.Timestamptz
  raw_payload  Json
  incident_id  String?   @db.Uuid
  incident     Incident? @relation(fields: [incident_id], references: [id])
  processed    Boolean   @default(false)

  @@unique([metric_name, service_name, detected_at])
  @@index([processed])
  @@map("anomalies")
}

model Incident {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  thread_id          String         @unique @db.Uuid // LangGraph checkpoint ID (same as id)
  status             IncidentStatus @default(OPEN)
  
  // Affiliation
  services_affected  String[]       // Grows as anomalies arrive
  
  // Core Diagnostics & Timeline
  root_cause_metric  Json?
  timeline           Json?
  causal_chain       Json?          // Array of CausalLink
  blast_radius       String[]
  ruled_out          Json?          // Array of RuledOutItem
  
  // LLM Report Data
  root_cause_service String?        @db.VarChar(255)
  rca_summary        String?        @db.Text
  fix_steps          Json?          // Array of steps generated by the LLM
  confidence         String?        // 'HIGH' | 'MEDIUM' | 'LOW'
  
  // Orchestration & Notification
  llm_fallback       Boolean        @default(false)
  llm_unavailable    Boolean        @default(false)
  notification_sent  Boolean        @default(false)

  // Timing
  started_at         DateTime       @default(now()) @db.Timestamptz
  updated_at         DateTime       @updatedAt @db.Timestamptz
  resolved_at        DateTime?      @db.Timestamptz

  // Relations
  anomalies          Anomaly[]

  @@map("incidents")
}

// Stores the user-defined service dependency graph (eoia-topology.yaml).
// Each row is one directed edge: upstream_service → downstream_service.
// The correlate_node reads this at runtime to determine causal direction.
model Topology {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  upstream_service   String   @db.VarChar(255) // e.g. "postgresql"
  downstream_service String   @db.VarChar(255) // e.g. "api_service"
  display_name       String?  @db.VarChar(255)
  description        String? // optional human note: "API reads DB on every request"
  created_at         DateTime @default(now()) @db.Timestamptz

  @@unique([upstream_service, downstream_service])
  @@index([downstream_service]) // look up "what does api_service depend on?"
  @@map("topology")
}

// Records deploy events ingested from GitHub webhooks
// The fetch_node and correlate_node surface these near the first_bad_timestamp.
model DeployEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  service_name  String   @db.VarChar(255) // derived from changed directory
  pr_title      String?
  branch        String   @db.VarChar(255)
  author        String   @db.VarChar(255)
  commit_sha    String   @db.VarChar(40)
  files_changed Json     @default("[]") // String[] of affected paths
  deployed_at   DateTime @db.Timestamptz // time of the push/merge event

  @@index([service_name, deployed_at])
  @@map("deploy_events")
}

// Metadata mirror for runbooks stored in ChromaDB.
// ChromaDB holds the vector embeddings; this table holds queryable metadata
// for the React runbook management UI
model Runbook {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chroma_id    String   @unique @db.VarChar(255) // ChromaDB document ID
  title        String   @db.VarChar(255)
  service_name String?  @db.VarChar(255) // null = applies to all services
  file_path    String? // original Markdown file path, for re-ingestion
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  @@index([service_name])
  @@map("runbooks")
}
