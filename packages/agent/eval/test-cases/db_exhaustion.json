  "ground_truth": {
    "root_cause_service": "postgresql",
    "affected_services": ["postgresql", "api_service", "nginx"],
    "expected_confidence": "HIGH",
    "expected_fix_keywords": ["pool", "connections", "pg_stat_activity", "kill", "restart"],
